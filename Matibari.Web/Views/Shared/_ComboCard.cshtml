@model Product
@{
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
    var items = CartService.GetComboItems(Model);
    var saved = Model.Mrp > Model.Price ? Model.Mrp - Model.Price : 0;
    var percent = Model.Mrp > 0 ? (int)Math.Round((double)(saved / Model.Mrp * 100)) : 0;
}
<div class="col">
    <article class="mb-combo-card @(Model.Featured ? "is-featured" : "") reveal">
        <div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="mb-combo-badge">✨ Special combo</span>
                @if (!string.IsNullOrEmpty(Model.Tag))
                {
                    <span class="mb-combo-badge @(Model.Featured ? "is-terra" : "is-outline")">@Model.Tag</span>
                }
                @if (Model.Featured)
                {
                    <span class="mb-combo-badge is-outline">👥 @items.Count products</span>
                }
            </div>

            <h3 class="h4">@Model.Name</h3>
            <p>@Model.Description</p>

            <p class="mb-combo-label">What's inside</p>
            <div class="mb-combo-includes">
                @foreach (var item in items)
                {
                    <span class="mb-combo-include">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="@item.Image" alt="@item.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="mb-thumb-ph" aria-hidden="true"></span>
                        }
                        @item.Name@(item.Qty > 1 ? $" ×{item.Qty}" : "")
                    </span>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
                <div>
                    <div class="mb-combo-price">
                        ₹@Model.Price
                        @if (Model.Mrp > Model.Price)
                        {
                            <small>₹@Model.Mrp</small>
                        }
                    </div>
                    <small style="color:rgba(244,237,216,.55);font-size:.74rem">@Model.Unit · inclusive of taxes</small>
                </div>
                @if (saved > 0)
                {
                    <span class="mb-combo-save">Save ₹@saved · @percent% off</span>
                }
            </div>

            <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button class="btn @(Model.Featured ? "btn-gold" : "btn-brand")" type="submit" @(Model.Stock <= 0 ? "disabled" : null)>
                    @(Model.Stock <= 0 ? "Sold out" : Model.Featured ? "Buy this combo" : "Buy combo")
                </button>
            </form>
        </div>

        <div class="mb-combo-media">
            @foreach (var item in items)
            {
                <figure>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="@item.Image" alt="@item.Name" loading="lazy" />
                    }
                    else
                    {
                        <div class="mb-thumb-ph"></div>
                    }
                    <figcaption>@item.Name</figcaption>
                </figure>
            }
        </div>
    </article>
</div>
