@model Product
@{
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}
<div class="col">
    <article class="mb-card d-flex flex-column reveal">
        <a class="mb-card-media d-block" asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id"
           aria-label="View details for @Model.Name">
            @if (Model.HasImage)
            {
                <img src="@Model.Image" alt="@Model.Name" loading="lazy" />
            }
            else
            {
                <div class="mb-card-placeholder" role="img" aria-label="@Model.Name">
                    <svg viewBox="0 0 120 120" aria-hidden="true">
                        <circle cx="60" cy="62" r="34" fill="#fff" opacity="0.55"></circle>
                        <path d="M60 34c12 6 18 16 18 27 0 12-8 21-18 25-10-4-18-13-18-25 0-11 6-21 18-27z" fill="#7a9b5f" opacity="0.85"></path>
                        <path d="M60 36v48" stroke="#3f5a2e" stroke-width="2.5" stroke-linecap="round"></path>
                        <path d="M34 92h52" stroke="#b5582c" stroke-width="4" stroke-linecap="round"></path>
                    </svg>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Tag))
            {
                <span class="mb-tag">@Model.Tag</span>
            }
        </a>

        <div class="p-3 d-flex flex-column flex-grow-1">
            <div class="mb-stars mb-1">★★★★★ <small>(@Model.Reviews)</small></div>
            <h3 class="mb-card-title">
                <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id"
                   class="text-decoration-none">@Model.Name</a>
            </h3>
            <p class="text-secondary mb-2" style="font-size:.76rem">@Model.Unit</p>
            <p class="mb-card-desc">@Model.Description</p>

            <div class="d-flex justify-content-between align-items-center gap-2 mt-auto">
                <div>
                    <span class="mb-price">₹@Model.Price</span>
                    @if (Model.Mrp > Model.Price)
                    {
                        <span class="mb-price-old">₹@Model.Mrp</span>
                    }
                </div>
                <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button class="btn btn-brand btn-sm" type="submit" @(Model.Stock <= 0 ? "disabled" : null)>
                        @(Model.Stock <= 0 ? "Sold out" : "Add to cart")
                    </button>
                </form>
            </div>
        </div>
    </article>
</div>
