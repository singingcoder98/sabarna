@using Matibari.Web.Data
@using Matibari.Web.Models
@using Matibari.Web.Services
@inject AppDbContext Db
@inject CartService Cart
@{
    var setting = Db.SiteSettings.FirstOrDefault() ?? new SiteSetting();
    var cartCount = Cart.Count;
    ViewData["Logo"] = setting.Logo;
    ViewData["Title"] ??= $"{setting.BrandName} | Handcrafted Organic Foods from Indian Farms";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string NavActive(string ctrl, string act) =>
        controller == ctrl && action == act ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en-IN" data-bs-theme="light">
<head>
    <partial name="_Head" />
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "OnlineStore",
          "name": "@setting.BrandName",
          "url": "https://www.matibari.in/",
          "logo": "@setting.Logo",
          "description": "Handcrafted, certified organic A2 Bilona Ghee, Raw Forest Honey, Achar and Bori sourced from Indian farming families.",
          "telephone": "@setting.Phone",
          "email": "@setting.Email",
          "priceRange": "₹₹",
          "paymentAccepted": "UPI, Credit Card, Debit Card, Net Banking",
          "areaServed": "IN",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "@setting.Address",
            "addressCountry": "IN"
          }
        }
    </script>
</head>
<body>
    <a class="visually-hidden-focusable" href="#main">Skip to content</a>

    <header class="mb-navbar navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <img src="@setting.Logo" alt="@setting.BrandName logo" class="mb-brand-logo" width="44" height="44" />
                <span class="d-flex flex-column">
                    <strong class="mb-brand-name">@setting.BrandName</strong>
                    <small class="mb-brand-tag">@setting.Tagline</small>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-3 mb-lg-0">
                    <li class="nav-item"><a class="@NavActive("Home", "Index")" href="/">Home</a></li>
                    <li class="nav-item"><a class="@NavActive("Shop", "Index")" href="/Shop">Shop</a></li>
                    <li class="nav-item"><a class="@NavActive("Shop", "Combos")" href="/Shop/Combos">Combos</a></li>
                    <li class="nav-item"><a class="@NavActive("Home", "About")" href="/Home/About">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#why">Why Organic</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#process">Our Process</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#faq">FAQ</a></li>
                    <li class="nav-item"><a class="@NavActive("Contact", "Index")" href="/Contact">Contact</a></li>
                </ul>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a href="/Cart" class="btn btn-outline-brand position-relative">
                        <span aria-hidden="true">🛒</span> Basket
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill mb-cart-badge">
                                @cartCount
                                <span class="visually-hidden">items in basket</span>
                            </span>
                        }
                    </a>
                    <a href="/Admin/Login" class="btn btn-link-light">Admin</a>
                    <a href="/Shop" class="btn btn-brand">Shop now</a>
                </div>
            </div>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="mb-footer" id="contact">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3">
                        <img src="@setting.Logo" alt="@setting.BrandName logo" class="mb-brand-logo" width="40" height="40" />
                        <strong class="mb-footer-brand">@setting.BrandName</strong>
                    </a>
                    <p class="mb-footer-text">
                        Pure, pesticide-free Indian staples grown by farming families and delivered
                        straight to your doorstep.
                    </p>
                    <div class="mb-pay-note">
                        🔒 <strong>Online payment only.</strong> Cash on Delivery is disabled. We accept UPI, cards &amp; netbanking.
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h4 class="mb-footer-heading">Quick links</h4>
                    <ul class="list-unstyled mb-footer-links">
                        <li><a href="/Shop">Shop products</a></li>
                        <li><a href="/Shop/Combos">Special combos</a></li>
                        <li><a href="/Home/About">About us</a></li>
                        <li><a href="/Home/About#process">Our process</a></li>
                        <li><a href="/Contact">Contact us</a></li>
                        <li><a href="/Home/Policies">Store policies</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h4 class="mb-footer-heading">Categories</h4>
                    <ul class="list-unstyled mb-footer-links">
                        <li><a href="/Shop?category=Dairy">Ghee &amp; dairy</a></li>
                        <li><a href="/Shop?category=Sweeteners">Honey</a></li>
                        <li><a href="/Shop?category=Pickles">Achar / pickles</a></li>
                        <li><a href="/Shop?category=Bori">Bori</a></li>
                        <li><a href="/Shop/Combos">Combo offers</a></li>
                    </ul>
                </div>

                <div class="col-lg-4">
                    <h4 class="mb-footer-heading">Get in touch</h4>
                    <ul class="list-unstyled mb-footer-links">
                        <li><span aria-hidden="true">📍</span> @setting.Address</li>
                        <li><span aria-hidden="true">📞</span> <a href="tel:@setting.Phone">@setting.Phone</a></li>
                        <li><span aria-hidden="true">✉️</span> <a href="mailto:@setting.Email">@setting.Email</a></li>
                        <li>
                            <span aria-hidden="true">💬</span>
                            <a href="https://wa.me/@setting.Whatsapp" target="_blank" rel="noopener">WhatsApp enquiry</a>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="mb-footer-rule" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <p class="mb-0 mb-footer-text">© @DateTime.Now.Year @setting.BrandName Pvt. Ltd. All rights reserved.</p>
                <div class="d-flex flex-wrap gap-3 mb-footer-links">
                    <a href="/Home/Shipping">Shipping</a>
                    <a href="/Home/Shipping#refund">Refunds</a>
                    <a href="/Home/Privacy">Privacy</a>
                    <a href="/Home/Terms">Terms</a>
                    <a href="/Admin/Login">Admin login</a>
                </div>
            </div>
        </div>
    </footer>

    <a class="mb-whatsapp" href="https://wa.me/@setting.Whatsapp?text=Hello%20@Uri.EscapeDataString(setting.BrandName)%2C%20I%20would%20like%20to%20know%20more%20about%20your%20organic%20products."
       target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
        <span class="mb-whatsapp-label"><b>Enquiry?</b> Chat on WhatsApp</span>
        <span class="mb-whatsapp-circle" aria-hidden="true">💬</span>
    </a>

    @if (TempData["Toast"] is string toastMessage)
    {
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
            <div class="toast align-items-center mb-toast" role="status" aria-live="polite" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">✅ @toastMessage</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
            <div class="toast align-items-center mb-toast mb-toast-error" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">⚠️ @errorMessage</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
