@using Matibari.Web.Data
@using Matibari.Web.Models
@inject AppDbContext Db
@{
    var setting = Db.SiteSettings.FirstOrDefault() ?? new SiteSetting();
    ViewData["Logo"] = setting.Logo;
    ViewData["Title"] ??= $"Admin | {setting.BrandName}";
}
<!DOCTYPE html>
<html lang="en-IN" data-bs-theme="light">
<head>
    <partial name="_Head" />
</head>
<body class="mb-admin">
    <div class="d-flex min-vh-100">
        @* Fixed sidebar on large screens *@
        <aside class="mb-admin-side d-none d-lg-flex flex-column d-print-none">
            <partial name="_AdminNav" />
        </aside>

        <div class="flex-grow-1 d-flex flex-column mb-admin-content">
            <nav class="navbar mb-admin-topbar sticky-top px-3 px-lg-4">
                <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#adminMenu" aria-controls="adminMenu" aria-label="Open admin menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <span class="navbar-text ms-auto small mb-admin-topdate">
                    @DateTime.Now.ToString("ddd, dd MMM yyyy")
                </span>
            </nav>

            <div class="p-3 p-lg-4 flex-grow-1">
                @RenderBody()
            </div>
        </div>
    </div>

    @* Slide-out menu for phones and tablets *@
    <div class="offcanvas offcanvas-start mb-admin-side" tabindex="-1" id="adminMenu" aria-labelledby="adminMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title mb-admin-brand" id="adminMenuLabel">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <partial name="_AdminNav" />
        </div>
    </div>

    @if (TempData["Toast"] is string toastMessage)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast align-items-center mb-toast" role="status" aria-live="polite" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">✅ @toastMessage</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast align-items-center mb-toast mb-toast-error" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">⚠️ @errorMessage</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
