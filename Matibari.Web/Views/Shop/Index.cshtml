@model ShopViewModel
@{
    ViewData["Title"] = $"Shop Organic Foods | {Model.Setting.BrandName}";
    var isAll = string.IsNullOrEmpty(Model.Category) || Model.Category == "All";
    ViewData["ReturnUrl"] = isAll ? "/Shop" : $"/Shop?category={Uri.EscapeDataString(Model.Category!)}";
}

<section class="mb-section">
    <div class="container">
        <div class="text-center mb-4">
            <span class="mb-kicker">Our shop</span>
            <h2 class="mb-title">All Organic Products</h2>
            <p class="mb-lead mb-lead-center">
                Individual products, packed fresh. Looking for bundles?
                <a href="/Shop/Combos" class="fw-semibold">See the special combos</a>.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-center mb-5">
            <a class="btn btn-sm @(isAll ? "btn-brand" : "btn-ghost")" href="/Shop">All</a>
            @foreach (var cat in Model.Categories)
            {
                <a class="btn btn-sm @(Model.Category == cat ? "btn-brand" : "btn-ghost")"
                   href="/Shop?category=@Uri.EscapeDataString(cat)">@cat</a>
            }
        </div>

        @if (!Model.Products.Any())
        {
            <div class="mb-panel mb-empty mx-auto" style="max-width:36rem">
                <div class="mb-empty-icon">🌾</div>
                <h3 class="h5">Fresh stock is on its way</h3>
                <p class="mb-lead mb-3">No products are live in this category right now. Please check back soon.</p>
                <a class="btn btn-brand" href="/Shop">Browse everything</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                @foreach (var product in Model.Products)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }
    </div>
</section>
