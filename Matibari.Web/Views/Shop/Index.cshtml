@model ShopViewModel
@{
    ViewData["Title"] = "Shop Organic Foods | Matibari";
}

<section class="section">
    <div class="container">
        <div class="center">
            <span class="kicker">Our Shop</span>
            <h2 class="section-title">All Organic Products</h2>
            <p class="lead muted">Individual products, packed fresh. Looking for bundles? Check the <a href="/Shop/Combos" style="color:var(--terracotta);font-weight:600">Special Combos</a>.</p>
        </div>

        <div class="center" style="margin:2.25rem 0 2.75rem;display:flex;flex-wrap:wrap;gap:.65rem;justify-content:center">
            <a class="btn btn-sm @(string.IsNullOrEmpty(Model.Category) || Model.Category == "All" ? "btn-dark" : "btn-ghost")" href="/Shop">All</a>
            @foreach (var cat in Model.Categories)
            {
                <a class="btn btn-sm @(Model.Category == cat ? "btn-dark" : "btn-ghost")" href="/Shop?category=@Uri.EscapeDataString(cat)">@cat</a>
            }
        </div>

        @if (!Model.Products.Any())
        {
            <div class="panel center" style="padding:4rem 2rem">
                <h3>Fresh stock is on its way</h3>
                <p class="muted">No products are live in this category right now. Please check back soon.</p>
            </div>
        }
        else
        {
            <div class="grid grid-3">
                @foreach (var product in Model.Products)
                {
                    <article class="card reveal">
                        <div class="card-media">
                            @if (product.HasImage)
                            {
                                <img src="@product.Image" alt="@product.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="card-placeholder" role="img" aria-label="@product.Name">
                                    <svg viewBox="0 0 120 120" aria-hidden="true">
                                        <path d="M60 34c12 6 18 16 18 27 0 12-8 21-18 25-10-4-18-13-18-25 0-11 6-21 18-27z" fill="#7a9b5f"></path>
                                        <path d="M34 92h52" stroke="#b5582c" stroke-width="4" stroke-linecap="round"></path>
                                    </svg>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(product.Tag))
                            {
                                <span class="badge">@product.Tag</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="stars">★★★★★ <small class="muted">(@product.Reviews)</small></div>
                            <h3 class="card-title">@product.Name</h3>
                            <p class="muted" style="font-size:.76rem;margin:0">@product.Unit · @product.Category</p>
                            <p class="card-desc">@product.Description</p>
                            <div class="card-foot">
                                <div>
                                    <span class="card-price">₹@product.Price</span>
                                    @if (product.Mrp > product.Price)
                                    {
                                        <span class="price-old">₹@product.Mrp</span>
                                    }
                                </div>
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@product.Id" />
                                    <input type="hidden" name="returnUrl" value="@($"/Shop?category={Model.Category}")" />
                                    <button class="btn btn-dark btn-sm" type="submit">Add to Cart</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
