@model List<Product>
@{
    ViewData["Title"] = "Special Combos — More Goodness, More Value! | Matibari";
    ViewData["ReturnUrl"] = "/Shop/Combos";
}

<section class="mb-section mb-combos">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-hero-badge">✨ Limited period bundles</span>
            <h2 class="mb-title mt-3">Special Combos — <span style="color:var(--mb-gold)">More goodness, more value!</span></h2>
            <p class="mb-lead mb-lead-center">
                Bundled together at a price that makes more sense — perfect for gifting, stocking up
                or tasting the full Matibari range.
            </p>
        </div>

        @if (!Model.Any())
        {
            <div class="mb-panel mb-empty mx-auto" style="max-width:36rem">
                <div class="mb-empty-icon">🎁</div>
                <h3 class="h5">Combos are being restocked</h3>
                <p class="mb-lead mb-3">
                    Please check back soon or browse our <a asp-controller="Shop" asp-action="Index">individual products</a>.
                </p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-xl-2 g-4">
                @foreach (var combo in Model)
                {
                    <partial name="_ComboCard" model="combo" />
                }
            </div>

            <p class="text-center mt-4 mb-0" style="color:rgba(244,237,216,.55);font-size:.78rem">
                Combo prices are managed from the admin dashboard · Free shipping on orders above ₹999
            </p>
        }
    </div>
</section>
