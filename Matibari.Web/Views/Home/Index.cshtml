@model HomeViewModel
@{
    ViewData["Title"] = $"{Model.Setting.BrandName} | Organic A2 Ghee, Raw Forest Honey, Achar & Bori";
    var setting = Model.Setting;
}

<!-- ============================== HERO ============================== -->
<section class="mb-hero">
    <div class="container position-relative">
        <div class="row">
            <div class="col-lg-9">
                <span class="mb-hero-badge">🌿 @setting.HeroKicker</span>
                <h1 class="mt-3">@setting.HeroTitle1 <span>@setting.HeroTitle2</span></h1>
                <p class="mb-4">@setting.HeroText</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="#products" class="btn btn-gold">Explore products →</a>
                    <a href="#combos" class="btn btn-outline-light">✨ See special combos</a>
                </div>

                <div class="mb-hero-stats">
                    <div><strong>5,000+</strong><small>Partner farmers</small></div>
                    <div><strong>100%</strong><small>FSSAI &amp; India Organic</small></div>
                    <div><strong>Pan India</strong><small>Doorstep delivery</small></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================ TRUST STRIP ============================ -->
<div class="mb-trust" aria-hidden="true">
    <div class="mb-trust-track">
        @for (var i = 0; i < 2; i++)
        {
            <span>100% Certified Organic</span>
            <span>No pesticides. No chemicals.</span>
            <span>FSSAI Approved</span>
            <span>Free shipping above ₹999</span>
            <span>Online payment only · No COD</span>
            <span>Secure UPI · Cards · Netbanking</span>
            <span>Plastic-free packaging</span>
        }
    </div>
</div>

<!-- ============================== ABOUT ============================== -->
<section class="mb-section" id="about">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <img class="mb-about-img reveal" src="/images/about-farmer.jpg"
                     alt="Indian organic farmers with a fresh harvest" loading="lazy" />
            </div>
            <div class="col-lg-6">
                <span class="mb-kicker">Our roots</span>
                <h2 class="mb-title">A Family Farm That Grew Into a Movement</h2>
                <p class="mb-lead">
                    Matibari began with one simple promise — food grown the way nature intended,
                    without synthetic pesticides or chemical fertilisers. Today that promise is kept
                    by farming families across India, and every product reaches your kitchen the way
                    it left the farm.
                </p>
                <p class="mb-lead">
                    We believe real food shouldn't need a warning label. That's why every grain,
                    spice, pickle and drop of honey we sell is traceable to the farm it came from.
                </p>

                <div class="row row-cols-1 row-cols-sm-3 g-3 mt-2">
                    <div class="col">
                        <div class="mb-value">
                            <h4>🌱 Natural farming</h4>
                            <p>Grown without synthetic pesticides or chemical fertilisers.</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="mb-value">
                            <h4>🤝 Fair to farmers</h4>
                            <p>We pay above market price directly to farming families.</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="mb-value">
                            <h4>♻️ Sustainable always</h4>
                            <p>Compostable, plastic-free packaging wherever possible.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================= PRODUCTS ============================= -->
<section class="mb-section mb-section-alt" id="products">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-kicker">Our shop</span>
            <h2 class="mb-title">Wholesome Staples for Your Kitchen</h2>
            <p class="mb-lead mb-lead-center">
                Hand-picked, lab-tested and packed fresh — everything you need for a truly organic Indian pantry.
            </p>
        </div>

        @if (Model.Products.Any())
        {
            ViewData["ReturnUrl"] = "/#products";
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                @foreach (var product in Model.Products)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
            <div class="text-center mt-4">
                <a class="btn btn-outline-brand" href="/Shop">View the full shop →</a>
            </div>
        }
        else
        {
            <div class="mb-panel mb-empty">
                <div class="mb-empty-icon">🌾</div>
                <h3 class="h5">Fresh stock is on its way</h3>
                <p class="mb-lead mb-lead-center mb-0">Please check back soon for this season's harvest.</p>
            </div>
        }
    </div>
</section>

<!-- =========================== SPECIAL COMBOS =========================== -->
@if (Model.Combos.Any())
{
    <section class="mb-section mb-combos" id="combos">
        <div class="container">
            <div class="text-center mb-5">
                <span class="mb-hero-badge">✨ Limited period bundles</span>
                <h2 class="mb-title mt-3">Special Combos — <span style="color:var(--mb-gold)">More goodness, more value!</span></h2>
                <p class="mb-lead mb-lead-center">
                    Our best-loved organic favourites bundled together at a price that makes more sense —
                    perfect for gifting, stocking up or tasting the full Matibari range.
                </p>
            </div>

            ViewData["ReturnUrl"] = "/#combos";
            <div class="row row-cols-1 row-cols-xl-2 g-4">
                @foreach (var combo in Model.Combos)
                {
                    <partial name="_ComboCard" model="combo" />
                }
            </div>

            <p class="text-center mt-4 mb-0" style="color:rgba(244,237,216,.55);font-size:.78rem">
                Combo prices are managed from the admin dashboard · Free shipping on orders above ₹999
            </p>
        </div>
    </section>
}

<!-- ============================== WHY US ============================== -->
<section class="mb-section" id="why">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-kicker">Why @setting.BrandName</span>
            <h2 class="mb-title">Why Thousands Trust Our Pantry</h2>
            <p class="mb-lead mb-lead-center">
                We don't just sell organic food — we obsess over every step between the farm and your kitchen shelf.
            </p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            <div class="col">
                <div class="mb-why-card">
                    <div class="mb-why-icon">🌾</div>
                    <h3>Soil to shelf, traced</h3>
                    <p>Every pack can be traced back to the farm and village it came from.</p>
                </div>
            </div>
            <div class="col">
                <div class="mb-why-card">
                    <div class="mb-why-icon">✅</div>
                    <h3>Triple certified</h3>
                    <p>India Organic, FSSAI and partner-farm certifications across our range.</p>
                </div>
            </div>
            <div class="col">
                <div class="mb-why-card">
                    <div class="mb-why-icon">📦</div>
                    <h3>Small-batch freshness</h3>
                    <p>Milled, packed and dispatched in small batches — never warehoused for months.</p>
                </div>
            </div>
            <div class="col">
                <div class="mb-why-card">
                    <div class="mb-why-icon">🔒</div>
                    <h3>Secure online payments</h3>
                    <p>Pay safely with UPI, cards or netbanking. Cash on Delivery is disabled.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================== PROCESS ============================= -->
<section class="mb-section mb-section-alt" id="process">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-kicker">Our process</span>
            <h2 class="mb-title">From Farmland to Your Dining Table</h2>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 text-center">
            <div class="col">
                <div class="mb-step">
                    <div class="mb-step-num">01</div>
                    <h3>Grown naturally</h3>
                    <p>Traditional organic methods — no synthetic chemicals, ever.</p>
                </div>
            </div>
            <div class="col">
                <div class="mb-step">
                    <div class="mb-step-num">02</div>
                    <h3>Harvested with care</h3>
                    <p>Hand-harvested at peak ripeness to lock in flavour and nutrition.</p>
                </div>
            </div>
            <div class="col">
                <div class="mb-step">
                    <div class="mb-step-num">03</div>
                    <h3>Tested &amp; certified</h3>
                    <p>Every batch passes independent lab tests before packing.</p>
                </div>
            </div>
            <div class="col">
                <div class="mb-step">
                    <div class="mb-step-num">04</div>
                    <h3>Delivered fast</h3>
                    <p>Packed in eco-friendly material and shipped to your door in 2-4 days.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================================ FAQ =============================== -->
<section class="mb-section" id="faq">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-kicker">Frequently asked questions</span>
            <h2 class="mb-title">Everything You Want to Know</h2>
            <p class="mb-lead mb-lead-center">Purity, delivery, payments — straight answers, no roundabouts.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="accordion mb-faq" id="faqAccordion">
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1"
                                    aria-expanded="true" aria-controls="faq1">
                                Are Matibari products certified organic?
                            </button>
                        </h3>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. Every product is grown without synthetic pesticides or chemical fertilisers and
                                tested in independent labs before packing.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                                Do you offer Cash on Delivery (COD)?
                            </button>
                        </h3>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                No. We accept online payments only — UPI, credit/debit cards and net banking — for
                                faster, safer, contactless delivery.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                                How long does delivery take?
                            </button>
                        </h3>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Orders are dispatched within 24 hours and delivered across India in 2-4 working days.
                                Shipping is free on orders above ₹999.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faq4" aria-expanded="false" aria-controls="faq4">
                                What is included in the special combos?
                            </button>
                        </h3>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Each combo card lists exactly what's inside. For example, the Honey + Bori + Achar
                                combo includes Raw Forest Honey, traditional Bori and our tangy Tok-Jhal Achar.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faq5" aria-expanded="false" aria-controls="faq5">
                                How can I place an order or ask a question?
                            </button>
                        </h3>
                        <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Add products to your basket and check out online, or tap the WhatsApp button to chat
                                with us directly for bulk orders and enquiries.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================ NEWSLETTER ============================ -->
<section class="mb-section pt-0" id="newsletter">
    <div class="container">
        <div class="mb-newsletter">
            <h2 class="mb-title">Get 10% Off Your First Order</h2>
            <p class="mb-4">Join our newsletter for seasonal recipes, farm stories and exclusive discounts.</p>

            <form asp-controller="Home" asp-action="Index" method="post" class="row justify-content-center g-2 mx-auto" style="max-width:34rem">
                @Html.AntiForgeryToken()
                <div class="col-12 col-sm">
                    <label class="visually-hidden" for="newsletterEmail">Email address</label>
                    <input type="email" id="newsletterEmail" name="email" class="form-control"
                           placeholder="Enter your email address" required />
                </div>
                <div class="col-12 col-sm-auto">
                    <button class="btn btn-brand w-100" type="submit">Subscribe</button>
                </div>
            </form>
        </div>
    </div>
</section>
