@{
    ViewData["Title"] = "Privacy Policy | Matibari";
    ViewData["Description"] = "How Matibari collects, uses and protects your personal data when you shop with us.";
}

<section class="mb-section">
    <div class="container" style="max-width:52rem">
        <span class="mb-kicker">Matibari · Legal</span>
        <h2 class="mb-title">Privacy Policy</h2>
        <p class="mb-lead">What we collect, why we collect it, and what we will never do with it.</p>
        <p class="text-secondary" style="font-size:.78rem">Last updated: November 2026</p>

        <div class="mb-panel mt-4">
            <h3 class="h5">What we collect</h3>
            <ul class="mb-0 ps-3" style="color:var(--mb-muted)">
                <li>Your name, email, phone number and delivery address — only what is needed to deliver your order.</li>
                <li>Order history, so we can help you with returns, replacements and repeats.</li>
                <li>Basic technical information from your browser (device type, pages viewed) to keep the site working well.</li>
            </ul>
        </div>

        <div class="mb-panel mt-3">
            <h3 class="h5">Payments</h3>
            <ul class="mb-0 ps-3" style="color:var(--mb-muted)">
                <li>Payments are handled by our payment gateway. We never store your card number, CVV or UPI PIN.</li>
                <li>We only receive a confirmation that the payment succeeded, plus a transaction reference.</li>
            </ul>
        </div>

        <div class="mb-panel mt-3">
            <h3 class="h5">What we never do</h3>
            <ul class="mb-0 ps-3" style="color:var(--mb-muted)">
                <li>We do not sell or rent your personal data to anyone.</li>
                <li>We do not share it with third parties for their own marketing.</li>
                <li>We do not send you messages after you unsubscribe.</li>
            </ul>
        </div>

        <div class="mb-panel mt-3">
            <h3 class="h5">Your rights</h3>
            <ul class="mb-0 ps-3" style="color:var(--mb-muted)">
                <li>Ask for a copy of the data we hold about you.</li>
                <li>Ask us to correct or delete it.</li>
                <li>Withdraw consent for marketing at any time.</li>
                <li>Write to us at <a href="mailto:hello@matibari.in">hello@matibari.in</a> and we will act within 30 days.</li>
            </ul>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Policies">← All policies</a>
            <a class="btn btn-brand" asp-controller="Contact" asp-action="Index">Questions? Contact us</a>
        </div>
    </div>
</section>
