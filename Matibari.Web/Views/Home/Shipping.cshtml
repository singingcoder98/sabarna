@{
    ViewData["Title"] = "Shipping & Returns Policy | Matibari";
    ViewData["Description"] = "Matibari shipping charges, delivery timelines, cancellations, refunds and replacement policy.";
}

<section class="mb-section">
    <div class="container" style="max-width:52rem">
        <span class="mb-kicker">Matibari · Legal</span>
        <h2 class="mb-title">Shipping &amp; Returns Policy</h2>
        <p class="mb-lead">Charges, timelines, cancellations and refunds — all in one place.</p>
        <p class="text-secondary" style="font-size:.78rem">Last updated: November 2026</p>

        <div class="mb-panel mt-4" id="shipping">
            <h3 class="h5">🚚 Shipping</h3>
            <ul class="mb-0 ps-3" style="color:var(--mb-muted)">
                <li>Orders are dispatched within 24 working hours of successful payment.</li>
                <li>Delivery across India takes 2–4 working days, depending on location.</li>
                <li>Shipping is <strong>free on all orders above ₹999</strong>. Below ₹999, a flat ₹79 applies.</li>
                <li>Tracking details are sent by email and WhatsApp as soon as your parcel leaves us.</li>
                <li>We do not deliver outside India at the moment.</li>
            </ul>
        </div>

        <div class="mb-panel mt-3" id="refund">
            <h3 class="h5">🔄 Cancellations &amp; refunds</h3>
            <ul class="mb-0 ps-3" style="color:var(--mb-muted)">
                <li>Cancel within 12 hours of ordering for a full refund, as long as the parcel has not shipped.</li>
                <li>Refunds go back to the original payment method within 5–7 working days.</li>
                <li>Failed or duplicate payments are auto-released by your bank within 3–5 working days.</li>
                <li>Opened food items cannot be returned for hygiene reasons.</li>
            </ul>
        </div>

        <div class="mb-panel mt-3" id="replacements">
            <h3 class="h5">📦 Damaged or wrong items</h3>
            <ul class="mb-0 ps-3" style="color:var(--mb-muted)">
                <li>Photograph the parcel and the item and send it to us <strong>within 48 hours of delivery</strong>.</li>
                <li>We replace damaged, leaking or spoiled items free of charge — no return shipment needed.</li>
                <li>If the item is out of stock, we issue a full refund instead of a replacement.</li>
                <li>Missing items are reshipped in the next dispatch cycle.</li>
            </ul>
            <div class="mt-3">
                <a class="btn btn-brand btn-sm" asp-controller="Contact" asp-action="Index">Report a problem →</a>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Policies">← All policies</a>
            <a class="btn btn-brand" asp-controller="Shop" asp-action="Index">Continue shopping</a>
        </div>
    </div>
</section>
