@{
    ViewData["Title"] = "About Us — Our Story | Matibari";
    ViewData["Description"] = "Matibari began with one promise: food grown the way nature intended. Meet the farming families and the process behind our organic ghee, honey, achar and bori.";
}

<section class="mb-hero" style="padding:4.5rem 0 3.75rem">
    <div class="container position-relative">
        <div class="row">
            <div class="col-lg-9">
                <span class="mb-hero-badge">🌿 About Matibari</span>
                <h1 class="mt-3">A Family Farm That<span>Grew Into a Movement.</span></h1>
                <p class="mb-0">
                    One promise, kept by thousands of farming families across India — food grown
                    the way nature intended, and delivered without losing a thing on the way.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="mb-section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <img class="mb-about-img" src="/images/about-farmer.jpg"
                     alt="Indian organic farmers with a fresh harvest" loading="lazy" />
            </div>
            <div class="col-lg-6">
                <span class="mb-kicker">Our roots</span>
                <h2 class="mb-title">It Started With One Kitchen Shelf</h2>
                <p class="mb-lead">
                    Matibari began in a family kitchen with a simple, stubborn idea: that the ghee,
                    honey, achar and bori we grew up eating should still be made the way our
                    grandmothers made them — slowly, by hand, and with nothing added.
                </p>
                <p class="mb-lead">
                    What started as one family's pantry became a network of partner farms across
                    India. Today every jar we sell is traceable to the village it came from, and the
                    farmer who grew it is paid above the market rate, directly.
                </p>
                <p class="mb-lead mb-0">
                    We believe real food shouldn't need a warning label. That is still the whole plan.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="mb-section mb-section-alt">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-kicker">What we stand for</span>
            <h2 class="mb-title">Three Promises We Don't Break</h2>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="mb-why-card">
                    <div class="mb-why-icon">🌱</div>
                    <h3>Natural farming</h3>
                    <p>
                        No synthetic pesticides, no chemical fertilisers, no shortcuts. Our partner farms
                        work with compost, crop rotation and traditional seed varieties.
                    </p>
                </div>
            </div>
            <div class="col">
                <div class="mb-why-card">
                    <div class="mb-why-icon">🤝</div>
                    <h3>Fair to farmers</h3>
                    <p>
                        We buy directly and pay above the local market rate — no middlemen deciding
                        what a harvest is worth.
                    </p>
                </div>
            </div>
            <div class="col">
                <div class="mb-why-card">
                    <div class="mb-why-icon">♻️</div>
                    <h3>Sustainable always</h3>
                    <p>
                        Compostable, plastic-free packing wherever possible, and small batches so
                        nothing sits in a warehouse for months.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-section" id="process">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-kicker">How we work</span>
            <h2 class="mb-title">From Farmland to Your Dining Table</h2>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 text-center">
            <div class="col"><div class="mb-step"><div class="mb-step-num">01</div>
                <h3>Grown naturally</h3><p>Traditional organic methods — no synthetic chemicals, ever.</p></div></div>
            <div class="col"><div class="mb-step"><div class="mb-step-num">02</div>
                <h3>Harvested with care</h3><p>Hand-harvested at peak ripeness to lock in flavour.</p></div></div>
            <div class="col"><div class="mb-step"><div class="mb-step-num">03</div>
                <h3>Tested &amp; certified</h3><p>Every batch passes independent lab tests before packing.</p></div></div>
            <div class="col"><div class="mb-step"><div class="mb-step-num">04</div>
                <h3>Delivered fast</h3><p>Eco-friendly packing, shipped to your door in 2–4 days.</p></div></div>
        </div>

        <div class="text-center mt-5">
            <a class="btn btn-brand" asp-controller="Shop" asp-action="Index">Shop the pantry →</a>
            <a class="btn btn-ghost ms-2" asp-controller="Contact" asp-action="Index">Talk to us</a>
        </div>
    </div>
</section>
