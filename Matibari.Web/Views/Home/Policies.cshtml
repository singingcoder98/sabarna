@{
    ViewData["Title"] = "Store Policies | Matibari";
    ViewData["Description"] = "Matibari shipping, refund, privacy and terms policies — clear, simple and honest.";
}

<section class="mb-section">
    <div class="container" style="max-width:52rem">
        <span class="mb-kicker">Matibari · Legal</span>
        <h2 class="mb-title">Store Policies</h2>
        <p class="mb-lead">
            Everything simple and clear. Each policy has its own page so you can read it,
            bookmark it or print it.
        </p>

        <div class="row row-cols-1 row-cols-md-2 g-3 mt-4">
            <div class="col">
                <a class="mb-policy-card" asp-controller="Home" asp-action="Shipping">
                    <span class="mb-policy-icon">🚚</span>
                    <h3>Shipping &amp; Returns</h3>
                    <p>Delivery timelines, ₹79 flat shipping, free above ₹999, cancellations and replacements.</p>
                    <span class="mb-policy-link">Read policy →</span>
                </a>
            </div>
            <div class="col">
                <a class="mb-policy-card" asp-controller="Home" asp-action="Privacy">
                    <span class="mb-policy-icon">🔒</span>
                    <h3>Privacy Policy</h3>
                    <p>What data we collect, how payments are handled, and what we will never do with it.</p>
                    <span class="mb-policy-link">Read policy →</span>
                </a>
            </div>
            <div class="col">
                <a class="mb-policy-card" asp-controller="Home" asp-action="Terms">
                    <span class="mb-policy-icon">📜</span>
                    <h3>Terms &amp; Conditions</h3>
                    <p>Pricing, prepaid-only payment, order confirmation and jurisdiction.</p>
                    <span class="mb-policy-link">Read policy →</span>
                </a>
            </div>
            <div class="col">
                <a class="mb-policy-card" asp-controller="Contact" asp-action="Index">
                    <span class="mb-policy-icon">💬</span>
                    <h3>Questions?</h3>
                    <p>Talk to a real person about an order, a return or a bulk enquiry.</p>
                    <span class="mb-policy-link">Contact us →</span>
                </a>
            </div>
        </div>

        <div class="mb-pay-note mt-4" style="color:var(--mb-muted);border-color:rgba(47,62,36,.25);background:var(--mb-cream-2)">
            <strong>In short:</strong> online payment only (no COD), dispatched in 24 working hours,
            delivered in 2–4 working days, and damaged parcels replaced free within 48 hours.
        </div>
    </div>
</section>
