@{
    ViewData["Title"] = "Store Policies | Matibari";
}

<section class="section">
    <div class="container" style="max-width:52rem">
        <span class="kicker">Matibari · Legal</span>
        <h2 class="section-title">Store Policies</h2>
        <p class="muted">Shipping, refunds, privacy and terms — everything simple and clear.</p>

        <div class="panel reveal" id="shipping" style="margin-top:2.25rem">
            <h3>🚚 Shipping Policy</h3>
            <ul class="muted">
                <li>Orders are dispatched within 24 working hours of successful payment.</li>
                <li>Delivery across India takes 2-4 working days, depending on location.</li>
                <li>Shipping is FREE on all orders above ₹999. Below ₹999, a flat ₹79 applies.</li>
                <li>Tracking details are sent on email and WhatsApp once shipped.</li>
                <li>We do not deliver outside India at the moment.</li>
            </ul>
        </div>

        <div class="panel reveal" id="refund" style="margin-top:1.5rem">
            <h3>🔄 Refund &amp; Cancellation Policy</h3>
            <ul class="muted">
                <li>Orders can be cancelled within 12 hours of placement for a full refund.</li>
                <li>Damaged, leaking or spoiled parcels: share a photo within 48 hours for a free replacement.</li>
                <li>Refunds are processed to the original payment method within 5-7 working days.</li>
                <li>Opened food items cannot be returned for hygiene reasons.</li>
                <li>Failed payments are auto-refunded by your bank within 3-5 working days.</li>
            </ul>
        </div>

        <div class="panel reveal" id="privacy" style="margin-top:1.5rem">
            <h3>🔒 Privacy Policy</h3>
            <ul class="muted">
                <li>We collect only what is needed to deliver your order: name, email, phone and address.</li>
                <li>Payments are handled securely by our payment gateway. We never store card or UPI details.</li>
                <li>We do not sell or share your personal data with any third party for marketing.</li>
                <li>To delete your data or ask a question, write to hello@@matibari.in.</li>
            </ul>
        </div>

        <div class="panel reveal" id="terms" style="margin-top:1.5rem">
            <h3>📜 Terms &amp; Conditions</h3>
            <ul class="muted">
                <li>All products are 100% natural — colour, texture and taste may vary slightly between harvest batches.</li>
                <li>Prices are inclusive of applicable taxes and may change without prior notice.</li>
                <li>Product images are for representation; actual packaging may vary.</li>
                <li>Cash on Delivery is not available. All orders are prepaid (UPI, cards, net banking).</li>
                <li>Any dispute is subject to jurisdiction of courts at Indore, Madhya Pradesh.</li>
            </ul>
        </div>
    </div>
</section>
