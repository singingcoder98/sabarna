@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout | Matibari";
    var itemCount = Model.Lines.Sum(l => l.Qty);
}

<section class="mb-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="mb-kicker">Step 2 of 2</span>
            <h2 class="mb-title">Secure Checkout</h2>
            <p class="mb-lead mb-lead-center">
                🔒 <strong>Online payment only</strong> — UPI, cards or netbanking. Cash on Delivery is not available.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="mb-panel">
                    <h3 class="h5 mb-3">Delivery details</h3>

                    <form asp-controller="Cart" asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="mb-validation"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Customer" class="form-label">Full name</label>
                                <input asp-for="Customer" class="form-control" placeholder="Your name" required />
                                <span asp-validation-for="Customer" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="+91 98765 43210" required />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PaymentMethod" class="form-label">Payment method</label>
                                <select asp-for="PaymentMethod" class="form-select">
                                    <option value="UPI">UPI (GPay / PhonePe / Paytm)</option>
                                    <option value="Card">Credit / Debit card</option>
                                    <option value="Netbanking">Netbanking</option>
                                </select>
                                <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label">Delivery address</label>
                                <textarea asp-for="Address" rows="3" class="form-control"
                                          placeholder="House, street, city, PIN code" required></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button class="btn btn-brand" type="submit">🔒 Pay ₹@Model.Total securely</button>
                            <a class="btn btn-ghost" asp-controller="Cart" asp-action="Index">← Back to basket</a>
                        </div>

                        <p class="text-secondary mt-3 mb-0" style="font-size:.72rem">
                            256-bit encrypted checkout · Free shipping on orders above ₹999 · All orders prepaid
                        </p>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="mb-panel">
                    <h3 class="h5 mb-3">Order summary (@itemCount items)</h3>

                    @foreach (var line in Model.Lines)
                    {
                        <div class="d-flex justify-content-between gap-3 py-2 border-bottom" style="border-color:var(--mb-line)!important">
                            <div>
                                <strong style="font-size:.9rem">@line.Name</strong>
                                <div class="text-secondary" style="font-size:.72rem">@line.Qty × ₹@line.Price</div>
                            </div>
                            <span style="font-size:.9rem">₹@line.LineTotal</span>
                        </div>
                    }

                    <div class="mb-total-row">
                        <strong>Total payable</strong>
                        <strong class="mb-price">₹@Model.Total</strong>
                    </div>

                    <ul class="list-unstyled mb-0" style="font-size:.76rem;color:var(--mb-muted)">
                        <li>✅ Dispatched within 24 working hours</li>
                        <li>✅ Delivered pan-India in 2–4 working days</li>
                        <li>✅ Damaged parcel? Free replacement within 48h</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
