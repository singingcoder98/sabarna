@{
    ViewData["Title"] = "Order Confirmed | Matibari";
    var orderNumber = TempData["OrderNumber"] as string ?? "MB-00000";
}

<section class="mb-section">
    <div class="container">
        <div class="mb-panel mb-empty mx-auto" style="max-width:36rem">
            <div class="mb-empty-icon">✅</div>
            <h2 class="mb-title" style="font-size:1.9rem">Payment successful!</h2>
            <p class="mb-lead mb-lead-center">
                Order <strong>@orderNumber</strong> is confirmed. A receipt has been sent to your email.
                Our farm team will pack and ship your order within 24 hours.
            </p>

            <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                <a class="btn btn-brand" asp-controller="Shop" asp-action="Index">Continue shopping</a>
                <a class="btn btn-ghost" href="/">Back to home</a>
            </div>
        </div>
    </div>
</section>
