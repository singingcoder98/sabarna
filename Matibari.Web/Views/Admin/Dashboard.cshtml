@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard | Matibari Admin";
    Layout = "_AdminLayout";
}

<div class="mb-page-head">
    <div>
        <h1>Overview</h1>
        <p>@DateTime.Now.ToString("dddd, dd MMMM yyyy") · Manage your organic store with care.</p>
    </div>
    <a class="btn btn-brand btn-sm" asp-action="Orders">Review orders →</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
    <div class="col">
        <div class="mb-stat">
            <small>Gross revenue</small>
            <strong>₹@Model.Revenue.ToString("N0")</strong>
        </div>
    </div>
    <div class="col">
        <div class="mb-stat">
            <small>Orders placed</small>
            <strong>@Model.TotalOrders</strong>
        </div>
    </div>
    <div class="col">
        <div class="mb-stat">
            <small>Products (live / total)</small>
            <strong>@Model.LiveProducts / @Model.TotalProducts</strong>
        </div>
    </div>
    <div class="col">
        <div class="mb-stat">
            <small>Low stock items</small>
            <strong>@Model.LowStock.Count</strong>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-xl-7">
        <h3 class="h6 mb-3">Recent orders</h3>
        <div class="mb-table-card table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Order</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Total</th>
                        <th scope="col">Payment</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders.Count == 0)
                    {
                        <tr><td colspan="5" class="text-secondary">No orders yet.</td></tr>
                    }
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>
                                @order.Customer<br />
                                <small class="text-secondary">@order.Email</small>
                            </td>
                            <td>₹@order.Total.ToString("N0")</td>
                            <td><span class="mb-pill mb-pill-green">@order.Payment · @order.PaymentMethod</span></td>
                            <td>
                                @switch (order.Status)
                                {
                                    case "Processing":
                                        <span class="mb-pill mb-pill-amber">Processing</span>
                                        break;
                                    case "Packed":
                                        <span class="mb-pill mb-pill-amber">Packed</span>
                                        break;
                                    case "Shipped":
                                        <span class="mb-pill mb-pill-green">Shipped</span>
                                        break;
                                    default:
                                        <span class="mb-pill mb-pill-grey">Delivered</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-xl-5">
        <h3 class="h6 mb-3">Low stock alerts</h3>
        @if (!Model.LowStock.Any())
        {
            <div class="mb-panel text-center">
                <p class="text-secondary mb-0">✅ All products are well stocked.</p>
            </div>
        }
        else
        {
            <div class="mb-table-card table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th scope="col">Product</th><th scope="col">Stock</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.LowStock)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td><span class="mb-pill mb-pill-red">@product.Stock units</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
