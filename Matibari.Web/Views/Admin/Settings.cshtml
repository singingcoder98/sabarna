@model SiteSetting
@{
    ViewData["Title"] = "Store Settings | Matibari Admin";
    Layout = "_AdminLayout";
}

<div class="admin-header">
    <div>
        <h1>Store settings</h1>
        <p class="muted" style="font-size:.85rem;margin:.35rem 0 0">
            Every field saves to the database and updates the live website.
        </p>
    </div>
</div>

<form asp-action="Settings" method="post" class="grid grid-2" style="align-items:start">
    @Html.AntiForgeryToken()

    <div class="panel">
        <h3>Brand identity</h3>
        <label class="field"><span>Brand name</span><input asp-for="BrandName" /></label>
        <label class="field"><span>Tagline</span><input asp-for="Tagline" /></label>
        <label class="field">
            <span>Logo path / URL</span>
            <input asp-for="Logo" placeholder="/images/logo.png" />
            <small>Upload your logo to wwwroot/images/ and give the path here.</small>
        </label>
    </div>

    <div class="panel">
        <h3>Hero banner</h3>
        <label class="field"><span>Top label</span><input asp-for="HeroKicker" /></label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.85rem">
            <label class="field"><span>Headline (line 1)</span><input asp-for="HeroTitle1" /></label>
            <label class="field"><span>Headline (line 2, highlighted)</span><input asp-for="HeroTitle2" /></label>
        </div>
        <label class="field"><span>Intro text</span><textarea asp-for="HeroText" rows="4"></textarea></label>
    </div>

    <div class="panel">
        <h3>Contact &amp; WhatsApp</h3>
        <label class="field"><span>Email</span><input asp-for="Email" /></label>
        <label class="field"><span>Phone</span><input asp-for="Phone" /></label>
        <label class="field">
            <span>WhatsApp number (for the chat button)</span>
            <input asp-for="Whatsapp" placeholder="919876543210" />
            <small>Country code ke saath, sirf digits. India ke liye 91 + 10 digit number.</small>
        </label>
        <label class="field"><span>Address</span><textarea asp-for="Address" rows="3"></textarea></label>
    </div>

    <div class="panel">
        <h3>How this works</h3>
        <div style="display:grid;gap:.85rem;font-size:.82rem;color:var(--muted)">
            <div style="background:#f4f7f2;border-radius:.85rem;padding:1rem">
                <b style="color:#3c5140">Database connected:</b> your changes are saved to the
                local SQLite database (<code>matibari.db</code>) and shown to every visitor.
            </div>
            <div style="background:#f8f3e4;border-radius:.85rem;padding:1rem">
                <b style="color:#7c6a41">Going bigger:</b> switch <code>appsettings.json</code>
                to SQL Server / PostgreSQL / Supabase — the same code keeps working.
            </div>
            <div style="background:#eef4ec;border-radius:.85rem;padding:1rem">
                <b style="color:#3c5140">Payments:</b> Razorpay keys go in
                <code>appsettings.json</code> when you integrate the gateway.
            </div>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;margin-top:1.35rem">
            💾 Save all changes
        </button>
    </div>
</form>
