@model SiteSetting
@{
    ViewData["Title"] = "Store Settings | Matibari Admin";
    Layout = "_AdminLayout";
}

<div class="mb-page-head">
    <div>
        <h1>Store settings</h1>
        <p>Every field saves to the database and updates the live website.</p>
    </div>
</div>

<form asp-action="Settings" method="post" class="row g-4 align-items-start">
    @Html.AntiForgeryToken()

    <div class="col-lg-8">
        <div class="row g-4">
            <div class="col-12">
                <div class="mb-panel">
                    <h3 class="h6 mb-3">Brand identity</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BrandName" class="form-label">Brand name</label>
                            <input asp-for="BrandName" class="form-control" />
                            <span asp-validation-for="BrandName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Tagline" class="form-label">Tagline</label>
                            <input asp-for="Tagline" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Logo" class="form-label">Logo path / URL</label>
                            <input asp-for="Logo" class="form-control" placeholder="/images/logo.png" />
                            <div class="form-text">Upload your logo to wwwroot/images/ and enter the path here.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="mb-panel">
                    <h3 class="h6 mb-3">Hero banner</h3>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="HeroKicker" class="form-label">Top label</label>
                            <input asp-for="HeroKicker" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HeroTitle1" class="form-label">Headline (line 1)</label>
                            <input asp-for="HeroTitle1" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HeroTitle2" class="form-label">Headline (line 2, highlighted)</label>
                            <input asp-for="HeroTitle2" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="HeroText" class="form-label">Intro text</label>
                            <textarea asp-for="HeroText" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="mb-panel">
                    <h3 class="h6 mb-3">Contact &amp; WhatsApp</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Whatsapp" class="form-label">WhatsApp number</label>
                            <input asp-for="Whatsapp" class="form-control" placeholder="919876543210" />
                            <div class="form-text">Country code included, digits only. For India: 91 + 10-digit number.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="mb-panel">
            <h3 class="h6 mb-3">How this works</h3>

            <div class="d-grid gap-3" style="font-size:.82rem;color:var(--mb-muted)">
                <div style="background:#f4f7f2;border-radius:.85rem;padding:1rem">
                    <strong style="color:#3c5140">Database connected:</strong> your changes are saved to the
                    SQLite database (<code>matibari.db</code>) and shown to every visitor.
                </div>
                <div style="background:#f8f3e4;border-radius:.85rem;padding:1rem">
                    <strong style="color:#7c6a41">Going bigger:</strong> switch <code>appsettings.json</code>
                    to SQL Server / PostgreSQL — the same code keeps working.
                </div>
                <div style="background:#eef4ec;border-radius:.85rem;padding:1rem">
                    <strong style="color:#3c5140">Payments:</strong> Razorpay keys go in
                    <code>appsettings.json</code> when you integrate the gateway.
                </div>
            </div>

            <button class="btn btn-brand w-100 mt-4" type="submit">💾 Save all changes</button>
        </div>
    </div>
</form>
