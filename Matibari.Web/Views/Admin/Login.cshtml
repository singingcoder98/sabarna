@model AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Login | Matibari";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en-IN" data-bs-theme="light">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="mb-auth">
        <section class="mb-auth-hero">
            <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                <img src="/images/logo.png" alt="Matibari logo" class="mb-brand-logo" width="44" height="44" />
                <span class="d-flex flex-column">
                    <strong class="mb-footer-brand">Matibari</strong>
                    <small class="mb-admin-muted">Admin workspace</small>
                </span>
            </a>

            <div>
                <span class="mb-hero-badge">🛡️ Two-step admin access</span>
                <h1 class="mt-3">Good food.<span>Good business.</span></h1>
                <p>
                    Password plus a one-time code keeps your store data — orders, sales and
                    customers — safe behind two locks.
                </p>
            </div>

            <p class="mb-0" style="color:rgba(244,237,216,.45);font-size:.78rem">
                Handcrafted | Natural | Traditional
            </p>
        </section>

        <section class="mb-auth-form">
            <div class="mb-auth-card">
                <a href="/" class="btn btn-ghost btn-sm mb-4">← Back to store</a>

                <span class="mb-kicker">Welcome back</span>
                <h2 class="mb-title" style="font-size:2rem">Admin sign in</h2>
                <p class="text-secondary" style="font-size:.88rem">Step 1 of 2 · Enter your admin credentials.</p>

                <form asp-action="Login" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="mb-validation"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Admin email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="you@matibari.in"
                               autocomplete="username" required autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control"
                               placeholder="Enter your password" autocomplete="current-password" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button class="btn btn-brand w-100" type="submit">Continue with OTP →</button>
                </form>

                <div class="mb-demo-note mt-4">
                    <strong>Preview environment</strong>
                    <p class="mb-0 mt-1">
                        Demo login: <b>saptarsree.b@@skykingindia.com</b> / <b>@@Saptarsee1998</b>.
                        The OTP is shown on screen in preview. Connect an email/SMS provider before production.
                    </p>
                </div>
            </div>
        </section>
    </div>

    <partial name="_Scripts" />
</body>
</html>
