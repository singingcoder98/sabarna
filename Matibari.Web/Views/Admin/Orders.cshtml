@model List<Order>
@{
    ViewData["Title"] = "Orders | Matibari Admin";
    Layout = "_AdminLayout";
    var status = ViewBag.Status as string ?? "All";
}

<div class="mb-page-head">
    <div>
        <h1>Orders</h1>
        <p>All orders are prepaid online (UPI / Card / Netbanking). Cash on Delivery is disabled.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var option in new[] { "All", "Processing", "Packed", "Shipped", "Delivered" })
        {
            <a class="btn btn-sm @(status == option ? "btn-brand" : "btn-ghost")"
               asp-action="Orders" asp-route-status="@option">@option</a>
        }
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="mb-panel text-center">
        <p class="text-secondary mb-0">No orders match this filter yet.</p>
    </div>
}
else
{
    <div class="mb-table-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Order</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Items</th>
                    <th scope="col">Total</th>
                    <th scope="col">Payment</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>
                            <strong>@order.OrderNumber</strong><br />
                            <small class="text-secondary">@order.CreatedAt.ToString("dd MMM, hh:mm tt")</small>
                        </td>
                        <td>
                            @order.Customer<br />
                            <small class="text-secondary">@order.Email</small>
                        </td>
                        <td>
                            @order.ItemCount ×<br />
                            <small class="text-secondary">@order.ProductName</small>
                        </td>
                        <td><strong>₹@order.Total.ToString("N0")</strong></td>
                        <td>
                            <span class="mb-pill @(order.Payment == "Paid" ? "mb-pill-green" : "mb-pill-red")">
                                @order.Payment · @order.PaymentMethod
                            </span>
                        </td>
                        <td>
                            @switch (order.Status)
                            {
                                case "Processing":
                                    <span class="mb-pill mb-pill-amber">Processing</span>
                                    break;
                                case "Packed":
                                    <span class="mb-pill mb-pill-amber">Packed</span>
                                    break;
                                case "Shipped":
                                    <span class="mb-pill mb-pill-green">Shipped</span>
                                    break;
                                default:
                                    <span class="mb-pill mb-pill-grey">Delivered</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            @if (order.Status != "Delivered")
                            {
                                <form asp-action="AdvanceOrder" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button class="btn btn-brand btn-sm" type="submit">
                                        @(order.Status == "Processing" ? "Pack order" : order.Status == "Packed" ? "Ship order" : "Mark delivered")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="mb-pill mb-pill-grey">✔ Complete</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
