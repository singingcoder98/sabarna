@model OtpViewModel
@{
    ViewData["Title"] = "Verify OTP | Matibari Admin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en-IN" data-bs-theme="light">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="mb-auth">
        <section class="mb-auth-hero">
            <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                <img src="/images/logo.png" alt="Matibari logo" class="mb-brand-logo" width="44" height="44" />
                <span class="d-flex flex-column">
                    <strong class="mb-footer-brand">Matibari</strong>
                    <small class="mb-admin-muted">Admin workspace</small>
                </span>
            </a>

            <div>
                <span class="mb-hero-badge">🛡️ Step 2 of 2</span>
                <h1 class="mt-3">Verify<span>your code.</span></h1>
                <p>
                    We sent a 6-digit one-time code to your admin email.
                    Codes expire in 5 minutes and lock after 5 wrong attempts.
                </p>
            </div>

            <p class="mb-0" style="color:rgba(244,237,216,.45);font-size:.78rem">
                Handcrafted | Natural | Traditional
            </p>
        </section>

        <section class="mb-auth-form">
            <div class="mb-auth-card">
                <a asp-action="Login" class="btn btn-ghost btn-sm mb-4">← Use a different account</a>

                <span class="mb-kicker">Step 2 of 2</span>
                <h2 class="mb-title" style="font-size:2rem">Verify your code</h2>
                <p class="text-secondary" style="font-size:.88rem">
                    Code sent to <strong>@Model.MaskedDestination</strong>
                </p>

                <form asp-action="VerifyOtp" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="mb-validation"></div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label">6-digit code</label>
                        <input asp-for="Code" class="form-control mb-auth-code" inputmode="numeric"
                               maxlength="6" pattern="[0-9]{6}" placeholder="••••••" autocomplete="one-time-code"
                               required autofocus />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DemoOtp))
                    {
                        <div class="mb-demo-note mb-3">
                            <b>Preview mode:</b> your demo code is
                            <b class="ms-1" style="font-family:monospace;font-size:1.05rem;letter-spacing:.22em">@Model.DemoOtp</b>
                        </div>
                    }

                    <button class="btn btn-brand w-100" type="submit">Verify &amp; open dashboard →</button>
                </form>

                <p class="text-secondary mt-4 mb-0" style="font-size:.72rem">
                    🔒 In production this code is delivered by SMS/email through your OTP provider
                    (MSG91 / Twilio) and verified on the server.
                </p>
            </div>
        </section>
    </div>

    <partial name="_Scripts" />
</body>
</html>
