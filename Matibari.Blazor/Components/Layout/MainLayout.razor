@inherits LayoutComponentBase
@implements IDisposable
@inject AppDbContext Db
@inject CartService Cart
@inject NavigationManager Nav

@{
    var setting = Db.SiteSettings.AsNoTracking().FirstOrDefault() ?? new SiteSetting();
    var waMessage = Uri.EscapeDataString($"Hello {setting.BrandName}, I would like to know more about your organic products.");
}

<PageTitle>@setting.BrandName | Organic A2 Ghee, Raw Forest Honey, Achar &amp; Bori — Buy Online</PageTitle>

<HeadContent>
    <meta name="description" content="Buy 100% natural & certified organic A2 Bilona Desi Ghee, Raw Forest Honey, Aam ka Achaar, Bori and special combos from Matibari. Fast pan-India delivery." />
    <meta name="keywords" content="organic ghee, raw forest honey, mango pickle, bori, achar, organic food India, Matibari" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@setting.BrandName — Handcrafted Organic Foods" />
    <meta property="og:description" content="Organic A2 Ghee, Raw Forest Honey, Achar, Bori & Special Combos — straight from Indian farms." />
    <meta property="og:image" content="@setting.Logo" />
</HeadContent>

<header class="navbar">
    <div class="container nav-inner">
        <a href="/" class="brand">
            <img src="@setting.Logo" alt="@setting.BrandName logo" class="brand-logo" />
            <span>
                <strong>@setting.BrandName</strong>
                <small>@setting.Tagline</small>
            </span>
        </a>

        <nav class="nav-links" id="navLinks">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/shop">Shop</NavLink>
            <NavLink href="/combos">Combos</NavLink>
            <NavLink href="/#why">Why Organic</NavLink>
            <NavLink href="/#process">Our Process</NavLink>
            <NavLink href="/#faq">FAQ</NavLink>
            <NavLink href="/#contact">Contact</NavLink>
        </nav>

        <div class="nav-actions">
            <a href="/cart" class="cart-btn">
                🛒 Basket
                @if (_cartCount > 0)
                {
                    <span class="cart-count">@_cartCount</span>
                }
            </a>
            <a href="/admin/login" class="btn btn-ghost">Admin</a>
            <a href="/shop" class="btn btn-primary">Shop Now</a>
        </div>

        <button class="nav-toggle" type="button" @onclick="ToggleNav" aria-label="Toggle menu">☰</button>
    </div>

    @if (_navOpen)
    {
        <nav class="mobile-nav">
            <NavLink href="/" Match="NavLinkMatch.All" @onclick="ToggleNav">Home</NavLink>
            <NavLink href="/shop" @onclick="ToggleNav">Shop</NavLink>
            <NavLink href="/combos" @onclick="ToggleNav">Combos</NavLink>
            <NavLink href="/#why" @onclick="ToggleNav">Why Organic</NavLink>
            <NavLink href="/#process" @onclick="ToggleNav">Our Process</NavLink>
            <NavLink href="/#faq" @onclick="ToggleNav">FAQ</NavLink>
            <NavLink href="/cart" @onclick="ToggleNav">Basket</NavLink>
            <NavLink href="/admin/login" @onclick="ToggleNav">Admin</NavLink>
        </nav>
    }
</header>

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast">@_toast</div>
}

<main>
    @Body
</main>

<footer class="footer" id="contact">
    <div class="container footer-grid">
        <div>
            <a href="/" class="brand brand-light">
                <img src="@setting.Logo" alt="@setting.BrandName logo" class="brand-logo" />
                <strong>@setting.BrandName</strong>
            </a>
            <p class="muted-light">Pure, pesticide-free Indian staples grown by farming families and delivered straight to your doorstep.</p>
            <div class="pay-note">
                🔒 <strong>Online payment only.</strong> Cash on Delivery is disabled. We accept UPI, cards &amp; netbanking.
            </div>
        </div>
        <div>
            <h4>Quick Links</h4>
            <ul>
                <li><a href="/shop">Shop Products</a></li>
                <li><a href="/combos">Special Combos</a></li>
                <li><a href="/#about">About Us</a></li>
                <li><a href="/#process">Our Process</a></li>
                <li><a href="/policies">Store Policies</a></li>
            </ul>
        </div>
        <div>
            <h4>Categories</h4>
            <ul>
                <li><a href="/shop?category=Dairy">Ghee &amp; Dairy</a></li>
                <li><a href="/shop?category=Sweeteners">Honey</a></li>
                <li><a href="/shop?category=Pickles">Achar / Pickles</a></li>
                <li><a href="/shop?category=Bori">Bori</a></li>
                <li><a href="/combos">Combo Offers</a></li>
            </ul>
        </div>
        <div>
            <h4>Get in Touch</h4>
            <ul>
                <li>📍 @setting.Address</li>
                <li>📞 @setting.Phone</li>
                <li>✉️ @setting.Email</li>
                <li>💬 <a href="https://wa.me/@setting.Whatsapp" target="_blank" rel="noopener">WhatsApp enquiry</a></li>
            </ul>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container footer-bottom-inner">
            <p>© @DateTime.Now.Year @setting.BrandName Pvt. Ltd. All rights reserved.</p>
            <div class="footer-links">
                <a href="/policies#shipping">Shipping</a>
                <a href="/policies#refund">Refunds</a>
                <a href="/policies#privacy">Privacy</a>
                <a href="/policies#terms">Terms</a>
                <a href="/admin/login">Admin login</a>
            </div>
        </div>
    </div>
</footer>

<a class="whatsapp-float" href="https://wa.me/@setting.Whatsapp?text=@waMessage" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <span class="wa-label"><b>Enquiry?</b> Chat with us on WhatsApp</span>
    <span class="wa-circle">💬</span>
</a>

@code {
    private int _cartCount;
    private bool _navOpen;
    private string? _toast;

    protected override void OnInitialized()
    {
        _cartCount = Cart.Count;
        Cart.Changed += OnCartChanged;
    }

    private void ToggleNav() => _navOpen = !_navOpen;

    private void OnCartChanged()
    {
        _cartCount = Cart.Count;
        _toast = Cart.Count > 0 ? "Added to your basket 🌿" : null;
        _ = InvokeAsync(StateHasChanged);

        if (_toast is not null)
        {
            _ = ClearToastAsync();
        }
    }

    private async Task ClearToastAsync()
    {
        await Task.Delay(2200);
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
