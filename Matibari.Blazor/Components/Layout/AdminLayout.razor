@inherits LayoutComponentBase
@inject AppDbContext Db
@inject AdminState Admin
@inject NavigationManager Nav

@{
    var setting = Db.SiteSettings.AsNoTracking().FirstOrDefault() ?? new SiteSetting();
}

<PageTitle>Admin | @setting.BrandName</PageTitle>

<div class="admin-wrap">
    <aside class="admin-side">
        <a href="/admin/dashboard" class="brand brand-light" style="margin-bottom:1.75rem">
            <img src="@setting.Logo" alt="@setting.BrandName logo" class="brand-logo" />
            <span>
                <strong style="font-size:1.05rem">@setting.BrandName</strong>
                <small style="color:rgba(233,196,106,.75)">Store admin</small>
            </span>
        </a>

        <p class="side-label">Workspace</p>
        <NavLink class="nav-item" href="/admin/dashboard">📊 Overview</NavLink>
        <NavLink class="nav-item" href="/admin/orders">📋 Orders</NavLink>
        <NavLink class="nav-item" href="/admin/products">📦 Products</NavLink>
        <NavLink class="nav-item" href="/admin/settings">⚙️ Store settings</NavLink>

        <p class="side-label" style="margin-top:1.35rem">Store</p>
        <a class="nav-item" href="/" target="_blank">🛍️ View storefront →</a>

        <div style="margin-top:auto">
            <div class="pay-note" style="margin-bottom:1rem">
                <b style="color:var(--gold)">🔐 Admin workspace</b><br />
                Signed in as @Admin.AdminName
            </div>
            <button class="nav-item" style="background:none;border:0;cursor:pointer;text-align:left;width:100%" @onclick="SignOut">
                🚪 Sign out
            </button>
        </div>
    </aside>

    <main class="admin-main">
        @Body
    </main>
</div>

@code {
    private void SignOut()
    {
        Admin.SignOut();
        Nav.NavigateTo("/admin/login");
    }
}
