@page "/cart"
@inject AppDbContext Db
@inject CartService Cart

<PageTitle>Your Basket | Matibari</PageTitle>

<section class="section">
    <div class="container">
        <div class="center">
            <span class="kicker">Your Basket</span>
            <h1 class="section-title">Review &amp; Checkout</h1>
            <p class="lead muted">🔒 <strong>100% Online Payment Only</strong> — Cash on Delivery is not available.</p>
        </div>

        @if (_orderPlaced)
        {
            <div class="panel center" style="max-width:36rem;margin:2.75rem auto;padding:3.5rem 2.25rem">
                <div style="font-size:3.25rem">✅</div>
                <h2 class="section-title" style="font-size:2rem">Payment Successful!</h2>
                <p class="muted">
                    Order <strong>@_orderNumber</strong> is confirmed. A receipt has been sent to your email.
                    Our farm team will pack and ship your order within 24 hours.
                </p>
                <div style="display:flex;gap:.85rem;justify-content:center;flex-wrap:wrap;margin-top:1.75rem">
                    <a class="btn btn-primary" href="/shop">Continue Shopping</a>
                    <a class="btn btn-ghost" href="/">Back to Home</a>
                </div>
            </div>
        }
        else if (!Cart.Lines.Any())
        {
            <div class="panel center" style="max-width:34rem;margin:2.75rem auto;padding:3.5rem 2rem">
                <div style="font-size:2.75rem">🛒</div>
                <h2 style="margin-top:.85rem">Your basket is empty</h2>
                <p class="muted">Add some organic goodness — ghee, honey, achar, bori or a special combo.</p>
                <a class="btn btn-primary" href="/shop" style="margin-top:1rem">Start Shopping</a>
            </div>
        }
        else
        {
            <div class="grid-cart" style="margin-top:2.75rem">
                <div>
                    <h3 style="margin-bottom:1.15rem">Items (@Cart.Count)</h3>
                    <div style="display:grid;gap:1rem">
                        @foreach (var line in Cart.Lines)
                        {
                            <div class="cart-line">
                                @if (!string.IsNullOrEmpty(line.Image))
                                {
                                    <img src="@line.Image" alt="@line.Name" />
                                }
                                else
                                {
                                    <div class="thumb-ph"></div>
                                }
                                <div style="flex:1">
                                    <div style="display:flex;justify-content:space-between;gap:1rem">
                                        <div>
                                            <strong>@line.Name</strong>
                                            @if (!string.IsNullOrEmpty(line.Includes))
                                            {
                                                <p style="font-size:.72rem;color:var(--muted);margin:.35rem 0 0">Includes: @line.Includes</p>
                                            }
                                        </div>
                                        <span class="card-price">₹@line.LineTotal</span>
                                    </div>
                                    <div style="display:flex;align-items:center;gap:1rem;margin-top:.85rem">
                                        <span class="qty">
                                            <button @onclick="() => Cart.SetQty(line.ProductId, line.Qty - 1)" aria-label="Decrease">−</button>
                                            <span>@line.Qty</span>
                                            <button @onclick="() => Cart.SetQty(line.ProductId, line.Qty + 1)" aria-label="Increase">+</button>
                                        </span>
                                        <button class="btn btn-ghost btn-sm" @onclick="() => Cart.Remove(line.ProductId)">Remove</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="panel">
                    <h3>Delivery &amp; Payment</h3>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-error">@_error</div>
                    }

                    <div style="margin-top:1.15rem">
                        <label class="field">
                            <span>Full name</span>
                            <input @bind="_customer" placeholder="Your name" />
                        </label>
                        <label class="field">
                            <span>Email</span>
                            <input @bind="_email" type="email" placeholder="you@example.com" />
                        </label>
                        <label class="field">
                            <span>Phone</span>
                            <input @bind="_phone" placeholder="+91 98765 43210" />
                        </label>
                        <label class="field">
                            <span>Delivery address</span>
                            <textarea @bind="_address" rows="3" placeholder="House, street, city, PIN code"></textarea>
                        </label>
                        <label class="field">
                            <span>Payment method (online only)</span>
                            <select @bind="_paymentMethod">
                                <option value="UPI">UPI (GPay / PhonePe / Paytm)</option>
                                <option value="Card">Credit / Debit Card</option>
                                <option value="Netbanking">Netbanking</option>
                            </select>
                            <small>🚫 Cash on Delivery is disabled. All orders are prepaid.</small>
                        </label>

                        <div style="display:flex;justify-content:space-between;align-items:center;padding:.95rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:1.15rem 0">
                            <strong>Subtotal</strong>
                            <strong class="card-price">₹@Cart.Total</strong>
                        </div>

                        <button class="btn btn-primary" style="width:100%" @onclick="PlaceOrder">
                            🔒 Pay ₹@Cart.Total Securely
                        </button>
                        <p class="center muted" style="font-size:.72rem;margin-top:.85rem">
                            Free shipping on orders above ₹999 · 256-bit encrypted checkout
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _customer = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _address = string.Empty;
    private string _paymentMethod = "UPI";
    private string? _error;
    private bool _orderPlaced;
    private string _orderNumber = string.Empty;

    private void PlaceOrder()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_customer) || string.IsNullOrWhiteSpace(_email) ||
            string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_address))
        {
            _error = "Please fill in all delivery details.";
            return;
        }

        if (!Cart.Lines.Any()) return;

        // Online payments only - Cash on Delivery is disabled.
        var allowed = new[] { "UPI", "Card", "Netbanking" };
        if (!allowed.Contains(_paymentMethod))
        {
            _error = "Only online payment is available.";
            return;
        }

        var lines = Cart.Lines.ToList();
        var first = lines.First();

        var order = new Order
        {
            OrderNumber = $"MB-{Random.Shared.Next(10000, 99999)}",
            Customer = _customer.Trim(),
            Email = _email.Trim(),
            ItemCount = lines.Sum(l => l.Qty),
            ProductName = lines.Count == 1 ? first.Name : $"{first.Name} +{lines.Count - 1} more",
            ProductImage = first.Image,
            Total = lines.Sum(l => l.LineTotal),
            Payment = "Paid",
            PaymentMethod = _paymentMethod,
            Status = "Processing"
        };

        Db.Orders.Add(order);
        Db.SaveChanges();

        _orderNumber = order.OrderNumber;
        _orderPlaced = true;
        Cart.Clear();
    }
}
