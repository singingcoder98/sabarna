@page "/"
@inject AppDbContext Db
@inject CartService Cart

<PageTitle>@_setting.BrandName | Organic A2 Ghee, Raw Forest Honey, Achar &amp; Bori — Buy Online</PageTitle>

<!-- ================= HERO ================= -->
<section class="hero">
    <div class="container hero-inner">
        <span class="hero-badge">@_setting.HeroKicker</span>
        <h1>@_setting.HeroTitle1 <span>@_setting.HeroTitle2</span></h1>
        <p>@_setting.HeroText</p>
        <div class="hero-actions">
            <a href="#products" class="btn btn-primary">Explore Products →</a>
            <a href="#combos" class="btn btn-outline">✨ See Special Combos</a>
        </div>
        <div class="hero-stats">
            <div><strong>5,000+</strong><small>Partner Farmers</small></div>
            <div><strong>100%</strong><small>FSSAI &amp; India Organic</small></div>
            <div><strong>Pan India</strong><small>Doorstep Delivery</small></div>
        </div>
    </div>
</section>

<!-- ================= TRUST STRIP ================= -->
<div class="trust-strip">
    <div class="marquee">
        @for (var i = 0; i < 2; i++)
        {
            <span>100% Certified Organic</span>
            <span>No Pesticides. No Chemicals.</span>
            <span>FSSAI Approved</span>
            <span>Free Shipping Above ₹999</span>
            <span>Online Payment Only · No COD</span>
            <span>Secure UPI · Cards · Netbanking</span>
            <span>Plastic-Free Packaging</span>
        }
    </div>
</div>

<!-- ================= ABOUT ================= -->
<section class="section" id="about">
    <div class="container split">
        <div>
            <img class="about-img" src="/images/about-farmer.jpg" alt="Indian organic farmers with fresh harvest" loading="lazy" />
        </div>
        <div>
            <span class="kicker">Our Roots</span>
            <h2 class="section-title">A Family Farm That Grew Into a Movement</h2>
            <p class="muted">
                Matibari began with one simple promise — food grown the way nature intended,
                without synthetic pesticides or chemical fertilisers. Today that promise is kept
                by farming families across India, and every product reaches your kitchen the way
                it left the farm.
            </p>
            <p class="muted">
                We believe real food shouldn't need a warning label. That's why every grain,
                spice, pickle and drop of honey we sell is traceable to the farm it came from.
            </p>
            <div class="value-grid">
                <div class="value"><h4>🌱 Natural Farming</h4><p>Grown without synthetic pesticides or chemical fertilisers.</p></div>
                <div class="value"><h4>🤝 Fair to Farmers</h4><p>We pay above market price directly to farming families.</p></div>
                <div class="value"><h4>♻️ Sustainable Always</h4><p>Compostable, plastic-free packaging wherever possible.</p></div>
            </div>
        </div>
    </div>
</section>

<!-- ================= PRODUCTS ================= -->
<section class="section section-alt" id="products">
    <div class="container">
        <div class="center">
            <span class="kicker">Our Shop</span>
            <h2 class="section-title">Wholesome Staples for Your Kitchen</h2>
            <p class="lead muted">Hand-picked, lab-tested and packed fresh — everything you need for a truly organic Indian pantry.</p>
        </div>

        <div class="grid grid-3" style="margin-top:3rem">
            @foreach (var product in _products)
            {
                <article class="card">
                    <div class="card-media">
                        @if (product.HasImage)
                        {
                            <img src="@product.Image" alt="@product.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-placeholder" role="img" aria-label="@product.Name">
                                <svg viewBox="0 0 120 120" aria-hidden="true">
                                    <circle cx="60" cy="62" r="34" fill="#fff" opacity="0.55"></circle>
                                    <path d="M60 34c12 6 18 16 18 27 0 12-8 21-18 25-10-4-18-13-18-25 0-11 6-21 18-27z" fill="#7a9b5f" opacity="0.85"></path>
                                    <path d="M60 36v48" stroke="#3f5a2e" stroke-width="2.5" stroke-linecap="round"></path>
                                    <path d="M34 92h52" stroke="#b5582c" stroke-width="4" stroke-linecap="round"></path>
                                </svg>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(product.Tag))
                        {
                            <span class="badge">@product.Tag</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="stars">★★★★★ <small class="muted">(@product.Reviews)</small></div>
                        <h3 class="card-title">@product.Name</h3>
                        <p class="muted" style="font-size:.76rem;margin:0">@product.Unit</p>
                        <p class="card-desc">@product.Description</p>
                        <div class="card-foot">
                            <div>
                                <span class="card-price">₹@product.Price</span>
                                @if (product.Mrp > product.Price)
                                {
                                    <span class="price-old">₹@product.Mrp</span>
                                }
                            </div>
                            <button class="btn btn-dark btn-sm" disabled="@(product.Stock <= 0)" @onclick="() => AddToCart(product)">
                                @(product.Stock <= 0 ? "Sold out" : "Add to Cart")
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- ================= SPECIAL COMBOS ================= -->
@if (_combos.Any())
{
    <section class="section combos" id="combos">
        <div class="container">
            <div class="center">
                <span class="hero-badge">✨ Limited Period Bundles</span>
                <h2 class="section-title combo-title" style="margin-top:1.35rem">
                    Special Combos — <span>More Goodness, More Value!</span>
                </h2>
                <p class="lead muted-light">
                    Our best-loved organic favourites bundled together at a price that makes more sense —
                    perfect for gifting, stocking up or tasting the full Matibari range.
                </p>
            </div>

            <div class="grid grid-2" style="margin-top:3.25rem">
                @foreach (var combo in _combos)
                {
                    var items = CartService.GetComboItems(combo);
                    var saved = combo.Mrp > combo.Price ? combo.Mrp - combo.Price : 0;
                    var percent = combo.Mrp > 0 ? (int)Math.Round((double)(saved / combo.Mrp * 100)) : 0;

                    <article class="combo-card @(combo.Featured ? "featured" : "")">
                        <div>
                            <div class="combo-badges">
                                <span class="combo-badge">✨ Special Combo</span>
                                @if (!string.IsNullOrEmpty(combo.Tag))
                                {
                                    <span class="combo-badge @(combo.Featured ? "terra" : "outline")">@combo.Tag</span>
                                }
                                @if (combo.Featured)
                                {
                                    <span class="combo-badge outline">👥 @items.Count Products</span>
                                }
                            </div>

                            <h3>@combo.Name</h3>
                            <p>@combo.Description</p>

                            <p style="font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin:1.15rem 0 .55rem">
                                What's inside
                            </p>
                            <div class="combo-includes">
                                @foreach (var item in items)
                                {
                                    <span class="combo-include">
                                        @if (!string.IsNullOrEmpty(item.Image))
                                        {
                                            <img src="@item.Image" alt="@item.Name" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="thumb-ph"></span>
                                        }
                                        @item.Name@(item.Qty > 1 ? $" ×{item.Qty}" : "")
                                    </span>
                                }
                            </div>

                            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin:1.35rem 0">
                                <div>
                                    <div class="combo-price">
                                        ₹@combo.Price
                                        @if (combo.Mrp > combo.Price)
                                        {
                                            <small>₹@combo.Mrp</small>
                                        }
                                    </div>
                                    <small style="color:rgba(244,237,216,.6)">@combo.Unit · inclusive of taxes</small>
                                </div>
                                @if (saved > 0)
                                {
                                    <span class="combo-save">Save ₹@saved · @percent% off</span>
                                }
                            </div>

                            <button class="btn @(combo.Featured ? "btn-gold" : "btn-primary")" @onclick="() => AddToCart(combo)">
                                @(combo.Featured ? "Buy This Combo" : "Buy Combo")
                            </button>
                        </div>

                        <div class="combo-media">
                            @foreach (var item in items)
                            {
                                <figure>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="card-placeholder thumb-ph" style="height:8.5rem">
                                            <svg viewBox="0 0 120 120" aria-hidden="true">
                                                <path d="M60 34c12 6 18 16 18 27 0 12-8 21-18 25-10-4-18-13-18-25 0-11 6-21 18-27z" fill="#7a9b5f"></path>
                                            </svg>
                                        </div>
                                    }
                                    <figcaption>@item.Name</figcaption>
                                </figure>
                            }
                        </div>
                    </article>
                }
            </div>

            <p class="center" style="margin-top:2.5rem;color:rgba(244,237,216,.55);font-size:.78rem">
                Combo prices are managed from the admin dashboard · Free shipping on orders above ₹999
            </p>
        </div>
    </section>
}

<!-- ================= WHY ================= -->
<section class="section why" id="why">
    <div class="container">
        <div class="center">
            <span class="hero-badge">Why Matibari</span>
            <h2 class="section-title">Why Thousands Trust Our Pantry</h2>
            <p class="lead">We don't just sell organic food — we obsess over every step between the farm and your kitchen shelf.</p>
        </div>
        <div class="why-grid">
            <div><div class="why-icon">🌾</div><h3>Soil to Shelf, Traced</h3><p>Every pack can be traced back to the farm and village it came from.</p></div>
            <div><div class="why-icon">✅</div><h3>Triple Certified</h3><p>India Organic, FSSAI and partner-farm certifications across our range.</p></div>
            <div><div class="why-icon">📦</div><h3>Small-Batch Freshness</h3><p>Milled, packed and dispatched in small batches — never warehoused for months.</p></div>
            <div><div class="why-icon">🔒</div><h3>Secure Online Payments</h3><p>Pay safely with UPI, cards or netbanking. Cash on Delivery is disabled.</p></div>
        </div>
    </div>
</section>

<!-- ================= PROCESS ================= -->
<section class="section" id="process">
    <div class="container">
        <div class="center">
            <span class="kicker">Our Process</span>
            <h2 class="section-title">From Farmland to Your Dining Table</h2>
        </div>
        <div class="steps">
            <div class="center"><div class="step-num">01</div><h3>Grown Naturally</h3><p>Traditional organic methods — no synthetic chemicals, ever.</p></div>
            <div class="center"><div class="step-num">02</div><h3>Harvested with Care</h3><p>Hand-harvested at peak ripeness to lock in flavour and nutrition.</p></div>
            <div class="center"><div class="step-num">03</div><h3>Tested &amp; Certified</h3><p>Every batch passes independent lab tests before packing.</p></div>
            <div class="center"><div class="step-num">04</div><h3>Delivered Fast</h3><p>Packed in eco-friendly material and shipped to your door in 2-4 days.</p></div>
        </div>
    </div>
</section>

<!-- ================= FAQ ================= -->
<section class="section section-alt" id="faq">
    <div class="container">
        <div class="center">
            <span class="kicker">Frequently Asked Questions</span>
            <h2 class="section-title">Everything You Want to Know</h2>
            <p class="lead muted">Purity, delivery, payments — saaf jawab, bina ghuma-phiraye.</p>
        </div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Are Matibari products certified organic?</summary>
                <p>Yes. Every product is grown without synthetic pesticides or chemical fertilisers and tested in independent labs before packing.</p>
            </details>
            <details class="faq-item">
                <summary>Do you offer Cash on Delivery (COD)?</summary>
                <p>No. We accept online payments only — UPI, credit/debit cards and net banking — for faster, safer, contactless delivery.</p>
            </details>
            <details class="faq-item">
                <summary>How long does delivery take?</summary>
                <p>Orders are dispatched within 24 hours and delivered across India in 2-4 working days. Shipping is free on orders above ₹999.</p>
            </details>
            <details class="faq-item">
                <summary>What is included in the Special Combos?</summary>
                <p>Each combo card lists exactly what's inside. For example, the Honey + Bori + Achar Combo includes Raw Forest Honey, traditional Bori and our tangy Tok-Jhal Achar.</p>
            </details>
            <details class="faq-item">
                <summary>How can I place an order or ask a question?</summary>
                <p>Add products to your basket and check out online, or tap the WhatsApp button to chat with us directly for bulk orders and enquiries.</p>
            </details>
        </div>
    </div>
</section>

<!-- ================= NEWSLETTER ================= -->
<section class="section newsletter">
    <div class="container">
        <h2>Get 10% Off Your First Order</h2>
        <p>Join our newsletter for seasonal recipes, farm stories and exclusive discounts.</p>
        <div style="display:flex;gap:.75rem;max-width:32rem;margin:1.75rem auto 0">
            <input @bind="_email" type="email" placeholder="Enter your email address" />
            <button class="btn" @onclick="Subscribe">Subscribe</button>
        </div>
        @if (!string.IsNullOrEmpty(_subscribed))
        {
            <p style="margin-top:1rem">@_subscribed</p>
        }
    </div>
</section>

@code {
    private SiteSetting _setting = new();
    private List<Product> _products = new();
    private List<Product> _combos = new();
    private string _email = string.Empty;
    private string? _subscribed;

    protected override void OnInitialized()
    {
        _setting = Db.SiteSettings.AsNoTracking().FirstOrDefault() ?? new SiteSetting();

        var active = Db.Products.AsNoTracking().Where(p => p.Active).ToList();
        _products = active.Where(p => !p.IsCombo).OrderBy(p => p.Id).ToList();
        _combos = active.Where(p => p.IsCombo).OrderByDescending(p => p.Featured).ToList();
    }

    private void AddToCart(Product product) => Cart.Add(product);

    private void Subscribe()
    {
        if (!string.IsNullOrWhiteSpace(_email))
        {
            _subscribed = $"Thank you for subscribing, {_email}! 🌿";
            _email = string.Empty;
        }
    }
}
