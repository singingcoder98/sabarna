@page "/admin/orders"
@layout AdminLayout
@inject AppDbContext Db
@inject AdminState Admin
@inject NavigationManager Nav

<PageTitle>Orders | Matibari Admin</PageTitle>

@if (!Admin.IsAuthenticated)
{
    <p class="muted">Redirecting to login…</p>
}
else
{
    <div class="admin-header">
        <div>
            <h1>Orders</h1>
            <p class="muted" style="font-size:.85rem;margin:.35rem 0 0">
                All orders are prepaid online (UPI / Card / Netbanking). Cash on Delivery is disabled.
            </p>
        </div>
        <div style="display:flex;gap:.55rem;flex-wrap:wrap">
            @foreach (var option in new[] { "All", "Processing", "Packed", "Shipped", "Delivered" })
            {
                var current = option;
                <button class="btn btn-sm @(_status == current ? "btn-dark" : "btn-ghost")" @onclick="() => SetFilter(current)">
                    @current
                </button>
            }
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Order</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Total</th>
                <th>Payment</th>
                <th>Status</th>
                <th style="text-align:right">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in _orders)
            {
                <tr>
                    <td><strong>@order.OrderNumber</strong><br /><small class="muted">@order.CreatedAt.ToString("dd MMM, hh:mm tt")</small></td>
                    <td>@order.Customer<br /><small class="muted">@order.Email</small></td>
                    <td>@order.ItemCount ×<br /><small class="muted">@order.ProductName</small></td>
                    <td><strong>₹@order.Total.ToString("N0")</strong></td>
                    <td><span class="pill @(order.Payment == "Paid" ? "pill-green" : "pill-red")">@order.Payment · @order.PaymentMethod</span></td>
                    <td><span class="pill @StatusClass(order.Status)">@order.Status</span></td>
                    <td style="text-align:right">
                        @if (order.Status != "Delivered")
                        {
                            <button class="btn btn-dark btn-sm" @onclick="() => Advance(order)">
                                @(order.Status == "Processing" ? "Pack order" : order.Status == "Packed" ? "Ship order" : "Mark delivered")
                            </button>
                        }
                        else
                        {
                            <span class="pill pill-grey">✔ Complete</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Order> _orders = new();
    private string _status = "All";

    protected override void OnInitialized()
    {
        if (!Admin.IsAuthenticated)
        {
            Nav.NavigateTo("/admin/login");
            return;
        }

        Load();
    }

    private void SetFilter(string status)
    {
        _status = status;
        Load();
    }

    private void Load()
    {
        var query = Db.Orders.AsNoTracking().AsQueryable();
        if (_status != "All") query = query.Where(o => o.Status == _status);
        _orders = query.OrderByDescending(o => o.CreatedAt).ToList();
    }

    private void Advance(Order order)
    {
        var tracked = Db.Orders.Find(order.Id);
        if (tracked is null) return;

        tracked.Status = tracked.Status switch
        {
            "Processing" => "Packed",
            "Packed" => "Shipped",
            "Shipped" => "Delivered",
            _ => tracked.Status
        };

        Db.SaveChanges();
        Load();
    }

    private static string StatusClass(string status) => status switch
    {
        "Delivered" => "pill-grey",
        "Shipped" => "pill-green",
        _ => "pill-amber"
    };
}
